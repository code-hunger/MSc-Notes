\begin_layout Plain Layout
\align center
why should the jumps at epoch 
\begin_inset Formula $(n)$
\end_inset

,
 be 
\begin_inset Formula $1\sqrt{n}$
\end_inset

?
\end_layout

\end_inset


\end_layout

\end_deeper
\begin_layout Subsection
Why jump with 
\begin_inset Formula $\pm\frac{1}{\sqrt{n}}$
\end_inset

 and why 
\begin_inset Formula $\Var\Delta W_{t}=t$
\end_inset


\end_layout

\begin_layout Standard
Why variance is 
\begin_inset Formula $t$
\end_inset

 (and not any other function of 
\begin_inset Formula $t$
\end_inset

) is explained by the 
\begin_inset Formula $\pm\frac{1}{\sqrt{n}}$
\end_inset

 jump in the approaching distributions,
 but without motivating that jump,
 the explanation is free-hanging.
\end_layout

\begin_layout Standard
Let 
\begin_inset Formula $\eta_{k}^{(n)}$
\end_inset

 be independent identically distributed with values 
\begin_inset Formula $-1$
\end_inset

 and 
\begin_inset Formula $1$
\end_inset

 with probability 
\begin_inset Formula $0.5$
\end_inset

 each.
 Set a random walk with jump 
\begin_inset Formula $\alpha_{n}>0$
\end_inset

:
 
\begin_inset Formula 
\[
\xi_{0}^{(n)}\coloneqq0,\quad\xi_{k+1}^{(n)}\coloneqq\xi_{k}^{(n)}+\alpha_{n}\eta_{k}^{(n)}
\]

\end_inset


\end_layout

\begin_layout Standard
Put a grid 
\begin_inset Formula $\{t_{0}^{(n)},\ldots,t_{n}^{(n)}\}$
\end_inset

 with 
\begin_inset Formula $t_{k}=k/n$
\end_inset

.
 Brownian motion will be the 
\begin_inset Quotes eld
\end_inset

limit random walk
\begin_inset Quotes erd
\end_inset

 as 
\begin_inset Formula $n$
\end_inset

 tends to infinity and the grid refines to the full interval 
\begin_inset Formula $[0,1]$
\end_inset

.
\end_layout

\begin_layout Standard
For a continuous variable 
\begin_inset Formula $t\in[0,1]$
\end_inset

,
 the nearest grid point to the left of 
\begin_inset Formula $t$
\end_inset

 at epoch 
\begin_inset Formula $n$
\end_inset

 is 
\begin_inset Formula $t^{(n)}\coloneqq\left\lfloor nt\right\rfloor /n,$
\end_inset

 so the 
\begin_inset Formula $k$
\end_inset

 at which 
\begin_inset Formula $\xi_{k}^{(n)}$
\end_inset

 can be evaluated is 
\begin_inset Formula $\left\lfloor nt\right\rfloor $
\end_inset

.
 Hence put 
\begin_inset Formula 
\begin{align*}
\xi_{t}^{(n)} & \coloneqq\xi_{\left\lfloor nt\right\rfloor }^{(n)}
\end{align*}

\end_inset

Now 
\begin_inset Formula 
\[
\Var\xi_{k}^{(n)}=\Var\sum_{i=1}^{k}\alpha_{n}\eta_{i}^{n}\overset{\perp}{=}\sum_{i=1}^{k}\Var\alpha_{n}\eta_{k}^{n}=\alpha_{n}^{2}k
\]

\end_inset

so 
\begin_inset Formula 
\begin{align*}
\Var\xi_{t}^{(n)} & =\Var\xi_{\left\lfloor nt\right\rfloor }^{(n)}=\alpha_{n}^{2}\left\lfloor nt\right\rfloor \\
 & =t^{(n)}\cdot n\alpha_{n}^{2}\\
 & =t^{(n)}\cdot\left(\alpha_{n}\sqrt{n}\right)^{2}
\end{align*}

\end_inset

where 
\begin_inset Formula $t^{(n)}$
\end_inset

 is the closest grid point to the left of 
\begin_inset Formula $t$
\end_inset

 as before at epoch 
\begin_inset Formula $n$
\end_inset

,
 and is clearly stable around a value in 
\begin_inset Formula $(0,1)$
\end_inset

 for large 
\begin_inset Formula $n$
\end_inset

.
 The problematic part is the other multiple,
 
\begin_inset Formula $\left(\alpha_{n}\sqrt{n}\right)^{2}$
\end_inset

:
\end_layout

\begin_layout Standard
\align center
